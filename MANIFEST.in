include README.md
include LICENSE
include pyproject.toml
include constraints-tested.txt
recursive-include docs *.md
recursive-include examples *.py *.json
recursive-include tests *.py *.json
prune .venv
prune .pytest_cache
prune build
prune dist
global-exclude *.py[cod]
global-exclude .coverage coverage.xml *.log *.tmp *.bak
